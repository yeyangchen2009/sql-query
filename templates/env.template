# 数据库连接配置 - 复制到项目根目录命名为 .env 并填写
#
# 规范:
#   - 默认连接使用 DB_* 前缀, 不加 --conn 时使用它
#   - 其他连接使用 <NAME>_DB_* 前缀, 用 --conn <name> 选择 (大小写不敏感)
#   - DB_TYPE: mysql | doris | tidb  (MySQL 协议, pymysql 驱动)
#              sqlserver | mssql     (TDS 协议,   pymssql 驱动)
#   - DB_PORT 可省略, 默认 MySQL 协议 3306 / SQL Server 1433

# ---------- 默认连接 ----------
DB_TYPE=doris
DB_HOST=127.0.0.1
DB_PORT=9030
DB_USER=your_user
DB_PASSWORD=your_password
DB_DATABASE=ods

# ---------- 示例: 追加一个 SQL Server 连接, 用 --conn rx 访问 ----------
# RX_DB_TYPE=sqlserver
# RX_DB_HOST=127.0.0.1
# RX_DB_PORT=1433
# RX_DB_USER=your_user
# RX_DB_PASSWORD=your_password
# RX_DB_DATABASE=your_db
